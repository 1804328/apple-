{
  "expo": {
    "name": "强提醒",
    "slug": "strong-reminder",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "strongreminder",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.legion.strongreminder",
      "infoPlist": {
        "NSAlarmKitUsageDescription": "需要创建系统闹钟级提醒，确保重要日期到点必定响铃。"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.legion.strongreminder",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "SYSTEM_ALERT_WINDOW",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "VIBRATE",
        "ACCESS_NOTIFICATION_POLICY"
      ]
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F14",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://ryanlewis.dpdns.org",
      "apiKey": "829393b8066a414c909e31d611613fad5da083c158e346ccada619c50b788965"
    }
  }
}
